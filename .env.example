# Copy to .env in this directory. Never commit the real file.
# `npm run campus:token` and `npm run campus:session` write the C@MPUS
# values below without editing this file by hand.
# Do not put a university password here. The password is typed only on
# https://idp.uni-stuttgart.de/idp/profile/oidc/authorize
# Variables named OIDC_PASSWORD, PASSWORD, CAMPUS_PASSWORD, SIAM_PASSWORD,
# or UNI_PASSWORD are ignored and a warning is printed.

XAI_API_KEY=
# Optional model override for `bun run quiz:from-pdf`.
# QUIZ_MODEL=grok-4.7
PORT=8787

# Token for the operator dashboard at http://127.0.0.1:8787/admin.
# Leave empty to keep the dashboard disabled. It is compared server-side and
# stored as an HttpOnly, SameSite=Strict cookie after the login form; never put
# it in an EXPO_PUBLIC_ variable.
DASHBOARD_TOKEN=

# The devices page records the IP address it sees. A reverse proxy on the same
# host (including a local cloudflared tunnel) is trusted automatically; set
# this to 1 when the proxy connects from another machine so X-Forwarded-For,
# X-Real-IP, or CF-Connecting-IP is used instead of the proxy's own address.
TRUST_PROXY=

# The Expo app reads these public URLs. They are not secrets.
# EXPO_PUBLIC_ASSISTANT_URL is an optional override:
#   - `off` disables the remote engine,
#   - a non-loopback value (a fixed LAN IP, another host) is used as-is,
#   - the default 127.0.0.1 makes the app reuse the Metro dev-server host on
#     the assistant port, so the simulator and a phone on the same Wi-Fi both
#     reach the server.
# Expo must be started after a change, because public env vars are read at
# bundle time.
EXPO_PUBLIC_ASSISTANT_URL=http://127.0.0.1:8787

# Written and cleared by `npm run assistant:tunnel` while a Cloudflare tunnel
# is up, so a phone off the LAN uses the public hostname while a local run
# keeps the base URL above. Leave it empty by hand; `npm run assistant:local`
# blanks a hostname left behind by a tunnel that was killed the hard way.
EXPO_PUBLIC_ASSISTANT_TUNNEL_URL=

# C@MPUS access token for the server only. Do not prefix with EXPO_PUBLIC_.
# Paste the token itself, or the full header value "Bearer <token>".
# The server reports only whether it is set: GET /health → campus.tokenConfigured.
# These are the operator account's credentials. They are bound to the account
# that signs in with them; a different student must connect C@MPUS through the
# in-app browser so the server keeps that user's own session.
# Never commit the filled-in value.
CAMPUS_BEARER_TOKEN=

# Value of the PSESSIONID cookie from the signed-in C@MPUS browser, without the name.
# CO_LANG, CO_PROFILE, PROFILE_CHOOSER_ENABLED, and SESSION_MODIFICATION_DEBUG are not the session.
CAMPUS_SESSION_COOKIE=

# ILIAS operator session. Optional: users normally connect in the app with their
# own account, and the server keeps only their PHPSESSID in memory. This .env
# value is for the single operator account; it is never sent to the app.
# Paste the cookie value, with or without the "PHPSESSID=" prefix.
# ILIAS_SESSION_COOKIE=
# ILIAS_ACCOUNT=

# Ids for one student. The study chooser (GET /v1/campus/studies) lists them.
CAMPUS_STUDY_ID=339485
CAMPUS_CURRICULUM_ID=278343

# How long an app session token stays valid, in hours. Default 720 (30 days).
# Tokens are stored hashed; changing this only affects new sign-ins.
# AUTH_SESSION_HOURS=720

# OIDC client issued by TIK (shibboleth-support@tik.uni-stuttgart.de).
# Both values stay on this server. They are not EXPO_PUBLIC_.
# Issuer default: https://idp.uni-stuttgart.de
# Test issuer, if TIK gives you a client there:
# OIDC_ISSUER=https://idp-test.tik.uni-stuttgart.de
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional. Prefills the account field on the IdP page (login_hint). Not a password.
# Example: st123456
OIDC_LOGIN_HINT=

# Scopes requested. Narrow this to what TIK enabled for the client.
OIDC_SCOPES=openid profile email uid siam

# Extra redirect URIs, comma-separated, in addition to the dev defaults
# (universityassistant://oidc, exp://, and http://localhost or 127.0.0.1 paths ending in /oidc).
# Set OIDC_ALLOW_DEV_REDIRECTS=false to allow only this list.
# OIDC_REDIRECT_URIS=https://example.uni-stuttgart.de/oidc
# OIDC_ALLOW_DEV_REDIRECTS=true

# The iOS build distribution service (dist-service/) and the client that
# publishes to it. The service reads this same file at startup; on a server, give
# it these variables through systemd instead and leave the file out.
# See dist-service/README.md.
# Token that authorises uploads and device edits. Empty disables both.
DIST_TOKEN=
# Where `npm run dist:publish` sends a build.
DIST_URL=http://127.0.0.1:8788
# The public origin used in the over-the-air install manifest. Must be https, or
# iOS refuses to install. Unset locally, where the request's host is used.
# DIST_PUBLIC_URL=https://builds.example.org
# Listen address and state directory for the service (defaults shown).
# DIST_PORT=8788
# DIST_HOST=127.0.0.1
# DIST_DATA_DIR=dist-service/data
