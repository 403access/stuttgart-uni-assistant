{
  "name": "@ua/quiz-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/content/index.ts",
    "./types": "./src/types.ts",
    "./content": "./src/content/index.ts",
    "./content/*": "./src/content/*.ts",
    "./figures/*": "./src/figures/*.ts",
    "./maps/*": "./src/maps/*.ts",
    "./package.json": "./package.json",
    "./content/generated": "./src/content/generated/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'content is checked by the root quiz checks'"
  },
  "dependencies": {
    "@ua/core": "workspace:*"
  }
}
