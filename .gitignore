# dependencies
node_modules/

# Expo
apps/mobile/.expo/
apps/mobile/dist/
web-build/
apps/mobile/expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
apps/mobile/.env

# typescript
*.tsbuildinfo

# generated native folders
/apps/mobile/ios
/apps/mobile/android

# local Expo module build output
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/ios/build/

# local databases
*.db
*.db-journal
*.db-wal
*.db-shm

# distribution service state (database and uploaded .ipa files)
/apps/dist/data/
/apps/dist/dist/
# machine-specific Cloudflare tunnel config; the example is tracked
/apps/dist/tunnel.yml

# admin production build
/apps/admin/dist/

# docs build output
/apps/docs/build/
/apps/docs/.docusaurus/
