{
  "name": "stuttgart-uni-assistant",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.3",
    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.13",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check-assistant.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/check-campus-db.ts && node --test server/oidc.test.mjs server/campus.test.mjs server/db.test.mjs server/mail.test.mjs scripts/set-campus-secret.test.mjs scripts/tunnel-assistant.test.mjs",
    "assistant": "node server/index.mjs",
    "assistant:tunnel": "node scripts/tunnel-assistant.mjs",
    "assistant:local": "node scripts/tunnel-assistant.mjs --clear",
    "campus:secret": "node scripts/set-campus-secret.mjs",
    "campus:token": "node scripts/set-campus-secret.mjs token",
    "campus:session": "node scripts/set-campus-secret.mjs session",
    "lint": "expo lint src app server scripts",
    "docs": "cd docs-site && bun run start",
    "docs:build": "cd docs-site && bun run build",
    "docs:serve": "cd docs-site && bun run serve"
  },
  "private": true,
  "patchedDependencies": {
    "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch"
  }
}
